rules_version = '2';

// Firestore security rules for the contact form.
// Paste this in Firebase Console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /messages/{docId} {
      // Anyone may create a message, but only with sane field types/sizes.
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 200 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.createdAt == request.time;

      // Nobody can read/update/delete from the browser.
      // Read the messages in the Firebase Console instead.
      allow read, update, delete: if false;
    }
  }
}
